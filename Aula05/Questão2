#include <stdio.h>
int main() {
    int opcao;
    float total = 0;

    do {
        printf("\n--- Cofrinho Digital ---\n");
        printf("1 - Adicionar moeda de R$0,50\n");
        printf("2 - Adicionar moeda de R$1,00\n");
        printf("3 - Adicionar moeda de R$2,00\n");
        printf("0 - Parar\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            total += 0.50;
        } else if (opcao == 2) {
            total += 1.00;
        } else if (opcao == 3) {
            total += 2.00;
        } else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }

        if (opcao >= 1 && opcao <= 3) {
            printf("Saldo atual: R$%.2f\n", total);
        }
    } while (opcao != 0);

    printf("\nTotal acumulado: R$%.2f\n", total);

    return 0;
}
