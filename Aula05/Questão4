#include <stdio.h>
int main() {
    int passos, total = 0, horas = 0;

    while (total < 10000) {
        horas++;
        printf("Passos dados na hora %d: ", horas);
        scanf("%d", &passos);

        total += passos;
        printf("Total ate agora: %d passos\n", total);
    }

    printf("\nMeta atingida! Foram necessarias %d hora(s).\n", horas);

    return 0;
}
